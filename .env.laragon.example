# Pengaturan SIMKEG untuk Windows + Laragon. Dipakai install.bat saat membuat .env.
APP_NAME=SIMKEG
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=single
LOG_LEVEL=warning

# MySQL bawaan Laragon: user root tanpa sandi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simkeg
DB_USERNAME=root
DB_PASSWORD=

# Sandi admin ditanyakan saat install.bat berjalan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
